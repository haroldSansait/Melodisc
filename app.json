{
  "expo": {
    "name": "Melodisc",
    "slug": "melodisc",
    "scheme": "melodisc",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/melodisc_app_cover.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/melodisc_app_cover.png",
      "resizeMode": "contain",
      "backgroundColor": "#121214"
    },
    "android": {
      "package": "com.vibemotion.melodisc",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/melodisc_app_cover.png",
        "backgroundColor": "#121214"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-av",
      "@react-native-google-signin/google-signin",
      "expo-image-picker",
      "expo-document-picker"
    ],
    "owner": "hksansait",
    "extra": {
      "eas": {
        "projectId": "c63d181a-6713-4e17-9d94-603652febfca"
      }
    }
  }
}